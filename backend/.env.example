PORT=5000
JWT_SECRET=replace_this_with_a_long_random_string
JWT_EXPIRES_IN=7d
MONGODB_URI=
# Comma-separated list of emails/phone numbers that always get the "admin"
# role on signup or login, regardless of what the signup form sends. Put
# your own email here before you sign up.
ADMIN_IDENTIFIERS=you@example.com

# Optional: for real AI-powered blueprint analysis instead of the built-in
# demo analyzer. Get a key at https://console.anthropic.com — the app works
# fully without this, using a deterministic demo analyzer instead.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-3-5-sonnet-latest
